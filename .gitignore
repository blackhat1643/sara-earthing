# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
out/

# production
build/
frontend/dist/
frontend/.next/
# backend/dist is intentionally tracked so git-based deploys work
dist.zip

# Passenger restart trigger — generated by CI, not committed
backend/tmp/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ignore large 3D models
public/images/city_suburbs.glb
public/images/city.glb
public/images/future_city_1.glb
public/images/*.skp
